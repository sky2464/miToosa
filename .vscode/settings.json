{
  "java.configuration.updateBuildConfiguration": "automatic",
  "chat.mcp.serverSampling": {
    "miToosa/.vscode/mcp.json: codacy/codacy-mcp-server": {
      "allowedModels": [
        "copilot/auto",
        "copilotcli/claude-haiku-4.5",
        "claude-code/claude-haiku-4.5",
        "copilot/claude-haiku-4.5",
        "copilotcli/claude-opus-4.5",
        "claude-code/claude-opus-4.5",
        "copilotcli/claude-opus-4.6",
        "claude-code/claude-opus-4.6",
        "copilot/claude-opus-4.6",
        "copilotcli/claude-sonnet-4",
        "claude-code/claude-sonnet-4",
        "copilotcli/claude-sonnet-4.5",
        "claude-code/claude-sonnet-4.5",
        "copilotcli/claude-sonnet-4.6",
        "claude-code/claude-sonnet-4.6",
        "copilot/claude-sonnet-4.6",
        "copilot/gemini-3-flash-preview",
        "copilot/gemini-3.1-pro-preview",
        "copilotcli/gpt-4.1",
        "copilotcli/gpt-5-mini",
        "copilot/gpt-5-mini",
        "copilotcli/gpt-5.1",
        "copilotcli/gpt-5.2",
        "copilotcli/gpt-5.2-codex",
        "copilotcli/gpt-5.3-codex",
        "copilotcli/gpt-5.4",
        "copilot/gpt-5.4",
        "copilotcli/gpt-5.4-mini",
        "copilot/gpt-5.4-mini",
        "copilot/grok-code-fast-1",
        "copilot/oswe-vscode-prime"
      ]
    }
  },
  "markdownlint.configFile": "${workspaceFolder}/.markdownlint.json",
  "markdownlint.run": "onSave",
  "markdownlint.lintWorkspaceGlobs": [
    "**/*.{md,mkd,mdwn,mdown,markdown,markdn,mdtxt,mdtext,workbook}",
    "!**/.git",
    "!**/build",
    "!**/node_modules",
    "!**/.dart_tool",
    "!**/.vscode-insiders",
    "!**/.gemini_security"
  ],
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "yaml.validate": false,
  "yaml.schemaStore.enable": false,
  "json.schemaDownload.enable": true,
  "json.schemas": [
    {
      "fileMatch": [".markdownlint.json", "**/.markdownlint.json"],
      "url": "./.vscode/markdownlint.schema.json"
    }
  ],
  "files.exclude": {
    "**/.vscode-insiders": true,
    "**/.gemini_security": true,
    "**/build": true,
    "**/.dart_tool": true
  },
  "python.testing.pytestArgs": [
    "."
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "markdownlint configuration",
  "description": "Local schema for .markdownlint.json to avoid remote schema downloads.",
  "type": "object",
  "additionalProperties": {
    "oneOf": [
      { "type": "boolean" },
      { "type": "number" },
      { "type": "string" },
      { "type": "null" },
      { "type": "object" }
    ]
  }
}
